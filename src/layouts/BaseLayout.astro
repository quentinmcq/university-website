---
import '@fontsource-variable/fraunces'
import '@fontsource-variable/source-sans-3'
import '../styles/global.css'
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import sourceSans from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url'
import { getImage } from 'astro:assets'
import iutPhoto from '../assets/iut.jpg'
import BackToTop from '../components/BackToTop.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import type { PageKey } from '../i18n/pages'
import { t } from '../i18n/ui'
import { getLocale, htmlLang, localePath, otherLocale, publicPath } from '../i18n/utils'

interface Props {
  pageKey: PageKey
  title: string
  description: string
}

const { pageKey, title, description } = Astro.props
const locale = getLocale(Astro.currentLocale)
const tr = t(locale)
const alternate = otherLocale(locale)

const site = Astro.site
const canonical = site ? new URL(localePath(locale, pageKey), site) : undefined
const alternateUrl = site ? new URL(localePath(alternate, pageKey), site) : undefined
const defaultUrl = site ? new URL(localePath('fr', pageKey), site) : undefined
const fullTitle = pageKey === 'home' ? tr('siteName') : `${title} · ${tr('siteShortName')}`

const ogImage = site
  ? await getImage({ src: iutPhoto, width: 1200, height: 630, format: 'jpeg', layout: 'none' })
  : undefined
const ogImageUrl = site && ogImage ? new URL(ogImage.src, site) : undefined
---

<!doctype html>
<html lang={htmlLang(locale)} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <link rel="alternate" hreflang={htmlLang(locale)} href={canonical} />}
    {alternateUrl && <link rel="alternate" hreflang={htmlLang(alternate)} href={alternateUrl} />}
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSans} as="font" type="font/woff2" crossorigin />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={publicPath('favicon.svg')} />
    {site && <link rel="sitemap" href={publicPath('sitemap-index.xml')} />}
    <meta name="theme-color" content="#2b3a48" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr('siteName')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={alternate === 'fr' ? 'fr_FR' : 'en_GB'} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={tr('homePhotoAlt')} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.remove('no-js')
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{tr('skipToContent')}</a>
    <SiteHeader locale={locale} pageKey={pageKey} />
    <main id="main" class="container" tabindex="-1" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <BackToTop locale={locale} />
  </body>
</html>
